Options -Indexes

# Bloquea el acceso directo a la configuración, al núcleo y al SQL
<FilesMatch "^(config|config\.example|db)\.php$|\.(sql|md|log|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
